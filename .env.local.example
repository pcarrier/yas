# Copy to .env.local (loaded by .envrc via dotenv_if_exists).

# Browser passphrase for `yas edge`; plaintext or `yas hash-passphrase` output.
YAS_PASSPHRASE=changeme

# Force a single codec+encoder (default priority list in CONTRIBUTING.md):
# YAS_SURFACE_ENCODERS=h264-vulkan
# YAS_SURFACE_ENCODERS=av1-vulkan
# YAS_SURFACE_ENCODERS=h264-nvenc
# YAS_SURFACE_ENCODERS=av1-nvenc
# YAS_SURFACE_ENCODERS=h264-vaapi
# YAS_SURFACE_ENCODERS=av1-vaapi
# YAS_SURFACE_ENCODERS=h264-software
# YAS_SURFACE_ENCODERS=av1-software
